# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editors ---
.idea/
.vscode/
*.swp
*.swo

# --- Node dependencies and caches ---
node_modules/
.npm/
.eslintcache

# --- Logs and runtime files ---
logs/
*.log
npm-debug.log*
*.pid

# --- Secrets and local environment (keep the safe template) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Build and test output ---
coverage/
.nyc_output/
dist/
build/

# --- Docker (local overrides only; Dockerfile and .dockerignore are tracked) ---
docker-compose.override.yml
.docker/

# --- Terraform (state and variable files can contain secrets) ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc
