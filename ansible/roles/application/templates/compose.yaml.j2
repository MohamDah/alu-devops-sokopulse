services:
  app:
    image: "{{ (acr_login_server ~ '/sokopulse:' ~ image_tag) if (deploy_from_acr | bool) else app_image }}"
    container_name: sokopulse
    env_file:
      - .env
    ports:
      - "3000:3000"
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
