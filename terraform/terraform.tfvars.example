# Copy this file to terraform.tfvars and edit it. terraform.tfvars is git-ignored.
# CI also reads this example for its security scan, so keep it free of real values:
# the key and address below are placeholders and cannot be used to deploy.

project_name   = "sokopulse"
location       = "southafricanorth"
vm_size        = "Standard_B2ats_v2"
admin_username = "azureuser"

# Contents of your PUBLIC key file, for example: cat ~/.ssh/id_ed25519.pub
admin_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePlaceholderKeyNotRealNotForDeployment example-not-a-real-key"

# Your own address in CIDR form (see the README for how to find the right one)
admin_source_cidr = "203.0.113.10/32"
